# ==============================================================================
# OpenLVET Environment Variables Template
# Copy this file to .env.local and update values as required
# ==============================================================================

# Node & Runtime
NODE_ENV=development
PORT=3000

# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_PREFIX=/api/v1

# Logging & Diagnostics
# Levels: DEBUG | INFO | WARN | ERROR | SILENT
LOG_LEVEL=INFO
ENABLE_LOG_BUFFER=true
LOG_BUFFER_CAPACITY=1000

# Third-Party Stock Media API Keys (Optional, provides live 4K search)
# Pexels API Key: Get for free at https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay API Key: Get at https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Freesound API Key & Client ID: Get at https://freesound.org/apiv2/
FREESOUND_CLIENT_ID=
FREESOUND_API_KEY=

# Storage & Persistence
# Options: opfs | indexeddb | memory
OPENLVET_STORAGE_PERSISTENCE=opfs
OPENLVET_MAX_PROJECT_SIZE_MB=2048

# Rendering Engine Settings
OPENLVET_RENDER_CONCURRENCY=2
OPENLVET_HARDWARE_ACCELERATION=true

# Optional Database & Authentication (for multi-user deployments)
DATABASE_URL=
BETTER_AUTH_SECRET=
