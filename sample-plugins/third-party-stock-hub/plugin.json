{
  "id": "third-party-stock-hub",
  "name": "第三方高清云素材库 (Cloud Stock Hub)",
  "version": "1.0.0",
  "description": "汇聚海量免版权 4K/1080P 视频空镜、精选摄影图、动态光效叠加层与电影级免版权 BGM 音效，支持一键导入到当前剪辑工程。",
  "author": "OpenLVET Open Stock Community",
  "category": "tools",
  "tags": [
    "素材库",
    "免版税",
    "4K视频",
    "BGM",
    "音效",
    "背景"
  ],
  "configSchema": [
    {
      "key": "defaultCategory",
      "label": "默认素材分类",
